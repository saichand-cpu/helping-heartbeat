# HumanLink production / local environment template
# Never commit real secret values to GitHub.

# Supabase public/client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New Supabase projects may use this server-side secret key instead:
SUPABASE_SECRET_KEY=

# Razorpay server-side
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging server-side
# Paste the Firebase service-account JSON as one environment variable. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# HUMI / Vercel AI Gateway
AI_GATEWAY_API_KEY=
HUMI_MODEL=openai/gpt-5.6-luna

# Optional fallbacks used by HUMI when AI Gateway is unavailable
LOVABLE_API_KEY=
OPENAI_API_KEY=
